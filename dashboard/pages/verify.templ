package pages

import (
	"strconv"

	"github.com/xraph/chronicle/dashboard/components"
	"github.com/xraph/chronicle/verify"
	"github.com/xraph/forgeui/components/button"
	"github.com/xraph/forgeui/components/card"
	"github.com/xraph/forgeui/components/input"
	"github.com/xraph/forgeui/components/separator"
	"github.com/xraph/forgeui/icons"
)

// VerifyPageData holds data for the verification page.
type VerifyPageData struct {
	Report   *verify.Report
	StreamID string
	FromSeq  string
	ToSeq    string
	Error    string
}

templ VerifyPage(data VerifyPageData) {
	<div class="space-y-6">
		<!-- Header -->
		<div>
			<h1 class="text-3xl font-bold tracking-tight">Hash Chain Verification</h1>
			<p class="text-muted-foreground mt-1">Verify the integrity of the immutable audit trail hash chain.</p>
		</div>

		<!-- Verification Form -->
		@card.Card(card.Props{Class: "rounded-sm"}) {
			@card.Header() {
				<div class="flex items-center gap-3">
					<div class="flex h-10 w-10 items-center justify-center rounded-sm bg-primary/10 text-primary">
						@icons.ShieldCheck(icons.WithSize(20))
					</div>
					<div>
						@card.Title() {
							Verify Chain Integrity
						}
						@card.Description() {
							Enter a stream ID and sequence range to verify hash chain integrity.
						}
					</div>
				</div>
			}
			@card.Content() {
				@separator.Separator()
				<form class="space-y-4 mt-4">
					<input type="hidden" name="action" value="verify"/>
					<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
						<div class="space-y-2">
							<label class="text-sm font-medium">Stream ID</label>
							@input.Input(input.Props{
								Name:        "stream_id",
								Placeholder: "stream_01h2x...",
								Attributes: templ.Attributes{
									"value": data.StreamID,
								},
							})
						</div>
						<div class="space-y-2">
							<label class="text-sm font-medium">From Sequence</label>
							@input.Input(input.Props{
								Type:        input.TypeNumber,
								Name:        "from_seq",
								Placeholder: "1",
								Attributes: templ.Attributes{
									"value": data.FromSeq,
								},
							})
						</div>
						<div class="space-y-2">
							<label class="text-sm font-medium">To Sequence</label>
							@input.Input(input.Props{
								Type:        input.TypeNumber,
								Name:        "to_seq",
								Placeholder: "100",
								Attributes: templ.Attributes{
									"value": data.ToSeq,
								},
							})
						</div>
					</div>
					@button.Button(button.Props{
						Variant: button.VariantDefault,
						Attributes: templ.Attributes{
							"hx-post":     "./verify",
							"hx-target":   "#content",
							"hx-swap":     "innerHTML",
							"hx-include":  "closest form",
							"hx-push-url": "false",
						},
					}) {
						@icons.ShieldCheck(icons.WithSize(16))
						Verify Chain
					}
				</form>
			}
		}

		<!-- Error -->
		if data.Error != "" {
			@card.Card(card.Props{Class: "rounded-sm border-destructive"}) {
				@card.Content(card.ContentProps{Class: "p-4"}) {
					<p class="text-sm text-destructive">{ data.Error }</p>
				}
			}
		}

		<!-- Verification Result -->
		if data.Report != nil {
			@card.Card(card.Props{Class: "rounded-sm"}) {
				@card.Header() {
					@card.Title() {
						Verification Result
					}
				}
				@card.Content() {
					<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
						@components.StatCard("shield-check", "Status", boolToStatus(data.Report.Valid), "")
						@components.StatCard("check-circle", "Verified", strconv.FormatInt(data.Report.Verified, 10), "events checked")
						@components.StatCard("activity", "Range", strconv.FormatUint(data.Report.FirstEvent, 10) + " - " + strconv.FormatUint(data.Report.LastEvent, 10), "sequence range")
						@components.StatCard("triangle-alert", "Issues", strconv.Itoa(issueCount(data.Report)), "gaps + tampered + downgrades")
					</div>

					<div>
						<dt class="text-sm font-medium text-muted-foreground mb-2">Chain Status</dt>
						<dd>
							@components.VerificationBadge(data.Report.Valid)
						</dd>
					</div>

					if len(data.Report.Gaps) > 0 {
						<div class="mt-4">
							<dt class="text-sm font-medium text-muted-foreground mb-2">Sequence Gaps</dt>
							<dd class="flex flex-wrap gap-2">
								for _, seq := range data.Report.Gaps {
									<code class="text-xs bg-muted/50 px-2 py-1 rounded-sm">{ strconv.FormatUint(seq, 10) }</code>
								}
							</dd>
						</div>
					}

					if len(data.Report.Downgrades) > 0 {
						<div class="mt-4 rounded-sm border border-destructive bg-destructive/5 p-4">
							<dt class="text-sm font-semibold text-destructive mb-1">Scheme Downgrades</dt>
							<p class="text-xs text-destructive mb-3">
								These events claim a weaker digest scheme than their stream is pinned to at that
								sequence. That is not old history. Someone rewrote them. Treat it as tampering and
								investigate who has write access to the events table.
							</p>
							<dd class="flex flex-wrap gap-2">
								for _, seq := range data.Report.Downgrades {
									<code class="text-xs bg-destructive/10 text-destructive px-2 py-1 rounded-sm">{ strconv.FormatUint(seq, 10) }</code>
								}
							</dd>
						</div>
					}

					if data.Report.CheckpointHeadChecked && !data.Report.CheckpointHeadOK {
						<div class="mt-4 rounded-sm border border-destructive bg-destructive/5 p-4">
							<dt class="text-sm font-semibold text-destructive mb-1">Truncated Tail</dt>
							<p class="text-xs text-destructive">
								A signed checkpoint says this chain once reached a sequence past the head this
								stream now claims. Events were removed from the end and the head row was moved
								down to match. Nothing inside the surviving range has to look wrong for that to
								have happened, so read this on its own: find out who holds write access to the
								events and streams tables.
							</p>
						</div>
					}

					if len(data.Report.Tampered) > 0 {
						<div class="mt-4">
							<dt class="text-sm font-medium text-muted-foreground mb-2">Tampered Events</dt>
							<dd class="flex flex-wrap gap-2">
								for _, seq := range data.Report.Tampered {
									<code class="text-xs bg-destructive/10 text-destructive px-2 py-1 rounded-sm">{ strconv.FormatUint(seq, 10) }</code>
								}
							</dd>
						</div>
					}

					if len(data.Report.Tolerant) > 0 {
						<div class="mt-4 rounded-sm border border-muted bg-muted/30 p-4">
							<dt class="text-sm font-medium mb-1">Resolved Tolerantly</dt>
							<p class="text-xs text-muted-foreground mb-3">
								These events recorded no digest scheme, so each historical scheme was tried in turn
								until one matched. They verified, but under a guess rather than a declaration. They
								predate their stream's pin, and that window cannot grow.
							</p>
							<dd class="flex flex-wrap gap-2">
								for _, seq := range data.Report.Tolerant {
									<code class="text-xs bg-muted/50 px-2 py-1 rounded-sm">{ strconv.FormatUint(seq, 10) }</code>
								}
							</dd>
						</div>
					}

					if len(data.Report.Coverage) > 0 {
						<div class="mt-4">
							<dt class="text-sm font-medium text-muted-foreground mb-2">Coverage</dt>
							<dd class="space-y-1">
								for _, cov := range data.Report.Coverage {
									<div class="text-xs flex flex-wrap items-baseline gap-2">
										<code class="bg-muted/50 px-2 py-1 rounded-sm">
											{ strconv.FormatUint(cov.FromSeq, 10) }-{ strconv.FormatUint(cov.ToSeq, 10) }: { string(cov.Level) }
										</code>
										if cov.Note != "" {
											<span class="text-muted-foreground">{ cov.Note }</span>
										}
									</div>
								}
							</dd>
						</div>
					}

					if len(data.Report.Checkpoints) > 0 {
						<div class="mt-4">
							<dt class="text-sm font-medium text-muted-foreground mb-2">Checkpoints</dt>
							<dd class="space-y-2">
								for _, cp := range data.Report.Checkpoints {
									switch checkpointStatus(cp) {
										case "failed":
											<div class="rounded-sm border border-destructive bg-destructive/5 p-3">
												<p class="text-xs font-semibold text-destructive">
													{ strconv.FormatUint(cp.FromSeq, 10) }-{ strconv.FormatUint(cp.ToSeq, 10) }: checkpoint failed
												</p>
												if cp.Note != "" {
													<p class="text-xs text-destructive mt-1">{ cp.Note }</p>
												}
											</div>
										case "inconclusive":
											<div class="rounded-sm border border-muted bg-muted/30 p-3">
												<p class="text-xs font-medium text-muted-foreground">
													{ strconv.FormatUint(cp.FromSeq, 10) }-{ strconv.FormatUint(cp.ToSeq, 10) }: not fully checked
												</p>
												if cp.Note != "" {
													<p class="text-xs text-muted-foreground mt-1">{ cp.Note }</p>
												}
											</div>
										default:
											<div class="text-xs text-muted-foreground">
												<code class="bg-muted/50 px-2 py-1 rounded-sm">
													{ strconv.FormatUint(cp.FromSeq, 10) }-{ strconv.FormatUint(cp.ToSeq, 10) }: signed and intact
												</code>
											</div>
									}
								}
							</dd>
						</div>
					}
				}
			}
		}
	</div>
}

func boolToStatus(valid bool) string {
	if valid {
		return "Valid"
	}
	return "Tampered"
}

// issueCount is what the Issues tile shows.
//
// Downgrades count. An event claiming a weaker digest scheme than its stream
// pins is a rewrite, and leaving it out of the headline number is how a
// verification that found one still reads as clean at a glance.
//
// Tolerant resolutions deliberately do not count. They are events written
// before the scheme was recorded at all, checked against each historical scheme
// in turn. That is a caveat on the strength of the answer, not a finding, and
// counting it would put a permanent number on every upgraded deployment's
// dashboard that no action could ever clear.
func issueCount(r *verify.Report) int {
	return len(r.Gaps) + len(r.Tampered) + len(r.Downgrades)
}

// checkpointStatus classifies one checkpoint result for display.
//
// "failed" means a check that actually ran found a mismatch: the signature
// did not verify, the recomputed hash disagrees, or continuity is broken.
//
// "inconclusive" means a check simply did not run. HashChecked and
// ContinuityChecked exist precisely so "not checked" cannot be misread as
// "failed" -- a covering checkpoint whose to_seq or predecessor falls
// outside a bounded sub-range legitimately leaves them false on an otherwise
// healthy checkpoint, and rendering that with the same styling as a real
// failure is the exact bug those fields were added to fix.
//
// Anything else -- signature valid, and every check that did run passed --
// is "valid".
func checkpointStatus(cr verify.CheckpointResult) string {
	if !cr.SignatureValid {
		return "failed"
	}
	if cr.HashChecked && !cr.HashMatch {
		return "failed"
	}
	if cr.ContinuityChecked && !cr.ContinuityOK {
		return "failed"
	}
	if !cr.HashChecked || !cr.ContinuityChecked {
		return "inconclusive"
	}
	return "valid"
}
